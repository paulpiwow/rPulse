# Local mode — rPulse's own Influx (rpulse-influx service), fed by the skid-sim
# service. Standalone demo, no rTruth required. This matches the compose
# defaults, so the file exists mainly to make the mode switch explicit and
# symmetric with .env.rtruth:
#   docker compose --env-file .env.local-influx up
RPULSE_INFLUX_URL=http://rpulse-influx:8181
RPULSE_INFLUX_DATABASE=skid_bucket
RPULSE_RTRUTH_URL=http://rpulse-influx:8181
RPULSE_RTRUTH_DATABASE=skid_bucket
RPULSE_STAGE1_CTAG_DESTINATION=local
