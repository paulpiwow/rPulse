# rTruth mode — point the backend at rTruth's Influx, host-published on 8087.
# Covers both the direct-read connection (RPULSE_INFLUX_*) and the Stage-1
# upstream source (RPULSE_RTRUTH_*). rTruth's compose project must be running.
# Usage:
#   docker compose --env-file .env.rtruth up
RPULSE_INFLUX_URL=http://host.docker.internal:8087
RPULSE_INFLUX_DATABASE=skid_bucket
RPULSE_RTRUTH_URL=http://host.docker.internal:8087
RPULSE_RTRUTH_DATABASE=skid_bucket
RPULSE_STAGE1_CTAG_DESTINATION=rtruth
